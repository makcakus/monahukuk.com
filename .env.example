# ─── Supabase (Newsletter backend) ──────────────────────────────────────────
# Supabase proje URL'si (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase service role key — yalnızca sunucu tarafında kullanılır (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Resend (E-posta gönderimi) ───────────────────────────────────────────────
# Resend API anahtarı (resend.com → API Keys)
RESEND_API_KEY=

# Resend Audience ID — bülten aboneleri için (resend.com → Audiences)
RESEND_AUDIENCE_ID=

# Gönderici adresi (ör. "MONA HUKUK <newsletter@monahukuk.com>")
RESEND_FROM_EMAIL=

# ─── Site ────────────────────────────────────────────────────────────────────
# Üretim ortamı URL'si (e-posta doğrulama linklerinde kullanılır)
NEXT_PUBLIC_SITE_URL=https://monahukuk.com
