# ─── Resend (E-posta gönderimi + abone listesi) ──────────────────────────────
# Resend API anahtarı (resend.com → API Keys)
RESEND_API_KEY=

# Resend Audience ID — bülten aboneleri için (resend.com → Audiences)
RESEND_AUDIENCE_ID=

# Gönderici adresi (ör. "MONA HUKUK <bulten@monahukuk.com>")
RESEND_FROM_EMAIL=

# ─── Newsletter JWT ───────────────────────────────────────────────────────────
# Token imzalama için rastgele güvenli string (en az 32 karakter)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEWSLETTER_JWT_SECRET=

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://monahukuk.com

# ─── İçerik senkronizasyonu (scripts/sync-articles-to-r2.mjs) ────────────────
# /api/revalidate-article route'unu korumak için rastgele güvenli string.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production'da: npx wrangler secret put REVALIDATE_SECRET
REVALIDATE_SECRET=
